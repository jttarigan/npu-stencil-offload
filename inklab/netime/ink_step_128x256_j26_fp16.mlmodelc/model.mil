            tensor<fp16, [1, 2, 256, 128]> gradp_cast_fp16 = conv(dilations = gradp_dilations_0, groups = gradp_groups_0, pad = gradp_pad_0, pad_type = gradp_pad_type_0, strides = gradp_strides_0, weight = gradp_weight_0_to_fp16, x = pad_29_cast_fp16)[name = tensor<string, []>("gradp_cast_fp16")];
